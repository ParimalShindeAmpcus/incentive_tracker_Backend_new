# ============================================================================
# APPLICATION
# ============================================================================

APP_NAME=Incentive Tracker API
ENVIRONMENT=development
DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
SEED_ON_STARTUP=True
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# ============================================================================
# DATABASE
# ============================================================================

DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incentive_tracker

# Or full URL instead of DB_* parts:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/incentive_tracker

# ============================================================================
# SECURITY / CORS
# ============================================================================

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8081
