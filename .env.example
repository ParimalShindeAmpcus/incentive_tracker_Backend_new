# ============================================================================
# UNIFIED MIS + PRISM BACKEND CONFIGURATION (.env)
# ============================================================================

# Application
APP_NAME="Unified MIS & PRISM API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
ENABLE_API_DOCS=True

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# ============================================================================
# STANDALONE DATABASE CONFIGURATION (PostgreSQL)
# Unified database for both Starts MIS and PRISM applications
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin@123
DB_NAME=mis_prism_db

# Starts MIS Database Settings (Schema: mis, asyncpg)
MIS_DB_HOST=localhost
MIS_DB_PORT=5432
MIS_DB_USER=postgres
MIS_DB_PASSWORD=admin@123
MIS_DB_NAME=mis_prism_db
MIS_DB_SCHEMA=mis

# PRISM Database Settings (Schema: prism, psycopg2)
PRISM_DB_HOST=localhost
PRISM_DB_PORT=5432
PRISM_DB_USER=postgres
PRISM_DB_PASSWORD=admin@123
PRISM_DB_NAME=mis_prism_db
PRISM_DB_SCHEMA=prism

# PRISM Seed settings
SEED_ON_STARTUP=True
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# ============================================================================
# SECURITY & AUTHENTICATION (JWT)
# ============================================================================
JWT_SECRET_KEY=generate-a-unique-random-secret-at-least-32-characters-mis-prism
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_RESET_MAX=5

# Security headers (HSTS, CSP)
HSTS_ENABLED=True
HSTS_MAX_AGE=31536000

# ============================================================================
# REDIS & CELERY (Optional Background Tasks)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# MIS: EMAIL INGESTION & JOBDIVA
# ============================================================================
JOBDIVA_API_BASE_URL=
JOBDIVA_API_KEY=

IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=True
IMAP_EMAIL=your_email@gmail.com
IMAP_PASSWORD=your_app_password
INBOX_FOLDER=INBOX
PROCESSED_FOLDER=Processed
FAILED_FOLDER=Failed
SENDER_FILTER=
TARGET_TABLE_NAME=imported_jobdiva_records
EMAIL_INGESTION_ENABLED=False
EMAIL_INGESTION_INTERVAL_MINUTES=30

# ============================================================================
# SMTP SETTINGS (Password Resets, Notifications, Reports)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="MIS & PRISM Platform"
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Password reset frontend redirect URL
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
INVITATION_TOKEN_EXPIRE_HOURS=48

# ============================================================================
# PRISM: SPECIAL INCENTIVE & VLOOKUP RECONCILIATION
# ============================================================================
SPECIAL_INCENTIVE_TIE_PAY_ALL=true
THRESHOLD_AUTO_MATCH=88.0
THRESHOLD_SUGGEST=80.0
THRESHOLD_REVIEW=70.0
HOURS_VALIDATION_CAP=160.0
