# ============================================================================
# COMPANY / DOMAIN
# ============================================================================

COMPANY_DOMAIN=http://localhost:5173

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DB_USER=postgres
DB_PASSWORD=admin@123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incentive_tracker

# ============================================================================
# APPLICATION SERVER CONFIGURATION
# ============================================================================

APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=True
APP_DEBUG=True
APP_NAME=Incentive Tracker

# ============================================================================
# ENVIRONMENT
# ============================================================================

ENVIRONMENT=development

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=WARNING

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
BCRYPT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# CORS (frontend Vite often runs on 8080 / 5173)
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Celery / Redis (optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
