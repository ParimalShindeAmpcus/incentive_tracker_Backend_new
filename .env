# Application Environment Variables
APP_NAME=Incentive Tracker API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (PostgreSQL — DB: incentive_tracker, schema: ims)
# Password "admin@123" is URL-encoded as admin%40123 (@ → %40)
DATABASE_URL=postgresql+psycopg2://postgres:admin%40123@localhost:5432/incentive_tracker
DATABASE_SCHEMA=ims

# Security / JWT
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
BCRYPT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# CORS (frontend Vite often runs on 8080 / 5173)
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Celery / Redis (optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
